<Window x:Class="PeriBattery.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PeriBattery" Width="456" Height="610" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" UseLayoutRounding="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" Deactivated="OnDeactivated" PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <!-- Device card. DataContext: DeviceVm. -->
        <DataTemplate x:Key="DeviceCard">
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="9" Background="{StaticResource IconBoxBrush}" Opacity="{Binding ContentOpacity}">
                        <Path Data="{Binding IconGeometry}" Style="{StaticResource DeviceIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" Style="{StaticResource NameBox}"
                                 HorizontalAlignment="Stretch" KeyDown="OnNameKeyDown"
                                 ToolTip="Haz clic para cambiar el nombre (déjalo vacío para restaurarlo)" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding ShowInPill}" VerticalAlignment="Center"
                              Margin="0,0,10,0" ToolTip="Mostrar en la píldora de la barra de tareas" />
                    <!-- Fixed width so rows line up whether or not the charging bolt is shown. -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Width="44">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource BatteryGlyph}"
                                        Opacity="{Binding ContentOpacity}" Focusable="False" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ChargeBolt}" Focusable="False" />
                    </StackPanel>
                    <TextBlock Grid.Column="4" Text="{Binding PercentText}" Foreground="{Binding LevelBrush}" FontSize="16" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" Width="28" Height="28" CornerRadius="14" BorderThickness="2" BorderBrush="Transparent">
                            <Ellipse Margin="3" Fill="{TemplateBinding Background}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="14" Background="{StaticResource FlyoutBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Padding="18,16,18,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <DockPanel>
            <!-- Header -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource IconBoxBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                    <Grid Width="24" Height="12">
                        <Border Width="21" HorizontalAlignment="Left" CornerRadius="3" BorderThickness="1.5" BorderBrush="{DynamicResource AccentBrush}">
                            <Border HorizontalAlignment="Left" Margin="1.5" Width="10" CornerRadius="1" Background="#2ECC8F" />
                        </Border>
                        <Rectangle Width="2" Height="5" RadiusX="1" RadiusY="1" HorizontalAlignment="Right" Fill="{DynamicResource AccentBrush}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PeriBattery" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Command="{Binding RefreshCommand}" ToolTip="Actualizar ahora"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72C;" FontSize="14" />
                    <Button Style="{StaticResource FlatButton}" Click="OnCloseClick" ToolTip="Cerrar"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE8BB;" FontSize="12" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>

            <TabControl x:Name="Tabs">
                <!-- Devices -->
                <TabItem Header="Dispositivos">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="CONECTADOS" Style="{StaticResource SectionLabel}" />
                            <ItemsControl ItemsSource="{Binding ConnectedDevices}" ItemTemplate="{StaticResource DeviceCard}" Focusable="False" />
                            <TextBlock Text="Buscando dispositivos…" Foreground="{StaticResource SubTextBrush}" FontSize="12.5" Margin="2,4,0,10"
                                       Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Visibility="{Binding HasDisconnected, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                <ToggleButton x:Name="DisconnectedToggle" IsChecked="True" Cursor="Hand" Margin="0,0,0,8" FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="2,1,7,0" />
                                                <TextBlock Text="{Binding DisconnectedHeader}" Foreground="{StaticResource TextBrush}" FontSize="13" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ItemsControl ItemsSource="{Binding DisconnectedDevices}" ItemTemplate="{StaticResource DeviceCard}" Focusable="False"
                                              Visibility="{Binding IsChecked, ElementName=DisconnectedToggle, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource RowHint}" Margin="2,6,0,0"
                                       Text="El interruptor de cada dispositivo decide si aparece en la píldora. Los niveles se leen directamente de los dispositivos, sin G HUB." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- General -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                                    <TextBlock Text="Iniciar con Windows" Style="{StaticResource RowLabel}" />
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding LowBatteryNotifications}" VerticalAlignment="Center" />
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Aviso de batería baja" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="Notificación al llegar al 10 %, una vez por ciclo de descarga." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HideInFullscreen}" VerticalAlignment="Center" />
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Ocultar en pantalla completa" Style="{StaticResource RowLabel}" />
                                        <TextBlock Text="Juegos en pantalla completa exclusiva o sin bordes." Style="{StaticResource RowHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DebugLog}" VerticalAlignment="Center" />
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Registro de depuración" Style="{StaticResource RowLabel}" />
                                            <TextBlock Text="Guarda en el registro cada trama HID enviada y recibida." Style="{StaticResource RowHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Button Style="{StaticResource OutlineButton}" Command="{Binding OpenLogsCommand}" Content="Abrir carpeta de registros"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Comunicación con los dispositivos" Style="{StaticResource RowLabel}" />
                                    <TextBlock Text="{Binding Diagnostics}" Style="{StaticResource RowHint}" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                            <DockPanel Margin="2,4,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding QuitCommand}" Content="Salir de PeriBattery" />
                                <TextBlock Text="{Binding Version}" Foreground="{StaticResource SubTextBrush}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Design -->
                <TabItem Header="Diseño">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PillScale, StringFormat={}{0:P0}}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                    <TextBlock Text="Tamaño de la píldora" Style="{StaticResource RowLabel}" />
                                </DockPanel>
                                <Slider Minimum="0.8" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding PillScale}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PillOpacity, StringFormat={}{0:P0}}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                    <TextBlock Text="Opacidad" Style="{StaticResource RowLabel}" />
                                </DockPanel>
                                <Slider Minimum="0.3" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding PillOpacity}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Color de acento" Style="{StaticResource RowLabel}" />
                                <ItemsControl x:Name="Swatches" ItemsSource="{Binding AccentPresets}" Margin="0,10,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource Swatch}" GroupName="Accent" Background="{Binding}" Tag="{Binding}"
                                                         Loaded="OnSwatchLoaded" Checked="OnSwatchChecked" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowPercentText}" VerticalAlignment="Center" />
                                <TextBlock Text="Mostrar el porcentaje en la píldora" Style="{StaticResource RowLabel}" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Visibility="{Binding HasSecondaryMonitors, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Otros monitores" Style="{StaticResource RowLabel}" />
                                <TextBlock Text="Elige en qué pantallas aparece la píldora y a qué lado de su barra de tareas." Style="{StaticResource RowHint}" />
                                <ItemsControl ItemsSource="{Binding SecondaryMonitors}" Margin="0,8,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Show}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                          ToolTip="Mostrar la píldora en esta pantalla" />
                                                <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Command="{Binding ToggleSideCommand}" Content="{Binding SideText}"
                                                        MinWidth="78" Padding="8,4" ToolTip="Lado de la barra de tareas (clic para cambiar)" />
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource RowLabel}" FontSize="12.5" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SecondaryPillScale, StringFormat={}{0:P0}}" Foreground="{StaticResource SubTextBrush}" FontSize="12" />
                                    <TextBlock Text="Tamaño en otros monitores" Style="{StaticResource RowLabel}" FontSize="12.5" />
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="1.6" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding SecondaryPillScale}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
